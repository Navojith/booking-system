{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap": "node dist/bootstrap.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "18.0.6",
    "helmet": "^8.3.0",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "~1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
