generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  /// Set for admin-issued temporary passwords; blocks everything but a password change.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz
  createdById  String?

  refreshTokens           RefreshToken[]
  registeredRegistrations Registration[] @relation("RegisteredBy")
  cancelledRegistrations  Registration[] @relation("CancelledBy")
  auditLogs               AuditLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

enum WorkshopStatus {
  DRAFT
  SCHEDULED
  CANCELLED
  COMPLETED
}

model Location {
  id        String     @id @default(uuid())
  name      String     @unique
  address   String
  workshops Workshop[]
}

model Workshop {
  id          String         @id @default(uuid())
  code        String         @unique
  title       String
  description String?
  instructor  String
  locationId  String
  startsAt    DateTime       @db.Timestamptz
  endsAt      DateTime       @db.Timestamptz
  capacity    Int
  /// Denormalised count of ACTIVE registrations; only changed by atomic conditional updates.
  seatsTaken  Int            @default(0)
  status      WorkshopStatus @default(SCHEDULED)
  /// Optimistic concurrency token for edits (ETag / If-Match).
  version     Int            @default(1)
  createdById String
  updatedById String
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  location      Location       @relation(fields: [locationId], references: [id])
  registrations Registration[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([locationId, startsAt])
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
  WAITLISTED
}

/// Never deleted: cancelling flips status and records who/when, so history is preserved.
model Registration {
  id             String             @id @default(uuid())
  workshopId     String
  attendeeName   String
  /// Normalised to lower-case.
  attendeeEmail  String
  status         RegistrationStatus
  registeredById String
  registeredAt   DateTime           @default(now()) @db.Timestamptz
  cancelledById  String?
  cancelledAt    DateTime?          @db.Timestamptz
  cancelReason   String?
  /// Set when a waitlisted registration was moved into a freed seat.
  promotedAt     DateTime?          @db.Timestamptz

  workshop     Workshop @relation(fields: [workshopId], references: [id])
  registeredBy User     @relation("RegisteredBy", fields: [registeredById], references: [id])
  cancelledBy  User?    @relation("CancelledBy", fields: [cancelledById], references: [id])

  @@index([workshopId, status])
  @@index([attendeeEmail])
  @@index([registeredAt])
}

/// Append-only: written in the same transaction as the change it describes.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  /// USER | WORKSHOP | REGISTRATION
  entityType String
  entityId   String
  before     Json?
  after      Json?
  requestId  String?
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
